  "analyse": {
    "maanedlig": {
      "overskrift": "Demografisk månedsoversigt for Hvidovre Kommune – juli 2026",
      "afsnit": [
        {
          "overskrift": "Folketal og udvikling",
          "tekst": "Hvidovre Kommunes folketal pr. 1. juli 2026 udgør 54.234 personer, hvilket afspejler en befolkningstilvækst på 59 borgere i den foregående måned. Set over de seneste 12 måneder er indbyggertallet steget med samlet 261 personer. Udviklingen viser således en fortsat stabil befolkningstilvækst i kommunen."
        },
        {
          "overskrift": "Indvandring",
          "tekst": "I maj 2026 blev der registreret 18 indvandringer bestående af 7 mænd og 11 kvinder, hvilket er et fald i forhold til de 52 indvandringer måneden før. Hovedparten af indvandrerne kom fra vestlige lande (78 %), hvor flest kom fra Nederlandene og Rumænien (hver 2 personer), mens 10 personer var i alderen 27-39 år og 4 personer i alderen 17-26 år. Derudover var der enkelte indvandringer fra Færøerne (1), Grønland (1) og Belgien (1) samt i aldersgrupperne 0-5 år (1), 6-16 år (1) og 40-64 år (2)."
        },
        {
          "overskrift": "Alderssammensætning",
          "tekst": "Aldersgruppen 80+ år udviser den største relative vækst, idet dens andel af befolkningen er øget fra 5,17 % til 5,33 % (2.892 personer). Omvendt oplever aldersgruppen 0-5 år det største fald i andel, da den udgør 6,44 % mod tidligere 6,57 % (3.493 personer). Ændringerne afspejler samlet set en svag forskydning i kommunens aldersprofil."
        }
      ]
    },
    "kvartal": {
      "overskrift": "Befolkningsudviklingen i Hvidovre Kommune i 2. kvartal 2026",
      "afsnit": [
        {
          "overskrift": "Samlet tilvækst",
          "tekst": "I 2. kvartal 2026 steg folketallet i Hvidovre Kommune med 82 personer, så indbyggertallet ved kvartalets udgang nåede 54.234. Den væsentligste drivkraft bag befolkningstilvæksten var en positiv indenlandsk nettotilflytning. Administrative korrektioner på -12 personer dæmpede den samlede tilvækst en smule."
        },
        {
          "overskrift": "Fødsler og dødsfald",
          "tekst": "Der blev registreret 129 fødsler og 125 dødsfald, hvilket resulterede i et beskedent fødselsoverskud på 4 personer. Dette afspejler en stort set neutral naturlig befolkningsudvikling i kvartalet. Fødselsoverskuddet har dermed haft en minimal betydning for den samlede befolkningstilvækst i perioden."
        },
        {
          "overskrift": "Flytninger og indvandring",
          "tekst": "Netto flyttede 87 personer til kommunen fra resten af Danmark, baseret på 992 tilflyttede og 905 fraflyttede. Ind- og udvandring lå tæt på hinanden med 99 indvandrede og 96 udvandrede, hvilket giver en nettoindvandring på 3 personer. Det er således den indenlandske tilflytning, der primært driver befolkningstilvæksten."
        }
      ]
    },
    "foedselDoed": {
      "overskrift": "Demografisk analyse for Hvidovre Kommune i 2. kvartal 2026",
      "afsnit": [
        {
          "overskrift": "Seneste kvartal",
          "tekst": "I 2. kvartal 2026 blev der registreret 129 levendefødte og 125 døde i Hvidovre Kommune, hvilket resulterede i et beskedent fødselsoverskud på 4 personer. Antallet af fødsler er steget svagt i forhold til samme kvartal året før (124), hvorimod antallet af dødsfald er steget markant fra 93. Denne stigning i dødsfald har medført et væsentligt lavere fødselsoverskud end i den tilsvarende periode i 2025."
        },
        {
          "overskrift": "Sammenligning med hele landet",
          "tekst": "Sammenlignet med indeksbasis i 3. kvartal 2015 viser fødselstallet i Hvidovre et fald til indeks 75, hvilket er betydeligt under udviklingen på landsplan (indeks 96). Omvendt er dødstallet i Hvidovre steget i mindre grad (indeks 102,5) end for hele landet (indeks 115,7). Den markant svagere udvikling i fødselstallet sammenlignet med hele landet begrænser Hvidovres naturlige befolkningstilvækst i forhold til det nationale gennemsnit."
        }
      ]
    }
  }
}