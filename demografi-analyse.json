  "analyse": {
    "maanedlig": {
      "overskrift": "Demografisk status for Hvidovre Kommune - Juni 2026",
      "afsnit": [
        {
          "overskrift": "Folketal og udvikling",
          "tekst": "Pr. 1. juni 2026 udgjorde folketallet i Hvidovre Kommune 54.175 borgere, hvilket markerer et fald på 21 personer som følge af bevægelserne i maj måned. Over de seneste 12 måneder er der dog tale om en samlet befolkningstilvækst, idet folketallet er steget med 237 personer. Den kortsigtede tilbagegang ændrer således ikke på en fortsat positiv langsigtet befolkningstendens i kommunen."
        },
        {
          "overskrift": "Indvandring",
          "tekst": "I maj måned indvandrede i alt 18 personer til kommunen, hvilket er et fald fra 52 personer måneden før, og heraf udgjorde vestlige indvandrere 78 pct. Kønsfordelingen var 7 mænd og 11 kvinder, og aldersmæssigt var gruppen af 27-39-årige den største med 10 personer. De primære oprindelseslande var Nederlandene og Rumænien med hver 2 personer, efterfulgt af Færøerne, Grønland og Belgien med hver 1 person."
        },
        {
          "overskrift": "Alderssammensætning",
          "tekst": "Aldersfordelingen viser, at gruppen af borgere på 80 år og derover oplevede den største relative vækst, idet dens andel af befolkningen steg med 0,18 procentpoint til 5,31 pct. Omvendt registreredes det største fald i gruppen af de 0-5-årige, hvis andel faldt med 0,16 procentpoint til 6,43 pct. Disse forskydninger afspejler en mindre forskydning mod en ældre befolkningssammensætning i kommunen."
        }
      ]
    },
    "kvartal": {
      "overskrift": "Befolkningsudviklingen i Hvidovre Kommune i 1. kvartal 2026",
      "afsnit": [
        {
          "overskrift": "Samlet tilvækst",
          "tekst": "I første kvartal 2026 oplevede Hvidovre Kommune en negativ befolkningstilvækst på i alt 76 personer, hvilket reducerede det samlede indbyggertal til 54.152 ved kvartalets udgang. Den primære drivkraft bag denne tilbagegang er en negativ indenlandsk flyttebalance. Dette fald blev kun delvist modsvaret af en positiv nettoindvandring fra udlandet."
        },
        {
          "overskrift": "Fødsler og dødsfald",
          "tekst": "Der blev i kvartalet registreret 107 fødsler og 139 dødsfald, hvilket resulterede i et fødselsunderskud på 32 personer. Dette negative fødselsresultat bidrager til den samlede befolkningsnedgang i perioden. Udviklingen viser, at den naturlige befolkningstilvækst i kommunen i øjeblikket er aftagende."
        },
        {
          "overskrift": "Flytninger og indvandring",
          "tekst": "Den indenlandske flyttebalance var negativ med et nettotab på 84 personer, baseret på 883 tilflyttede og 967 fraflyttede. Modsat herpå var den internationale migration positiv med en nettoindvandring på 45 personer, hvor 164 indvandrede og 119 udvandrede. Samlet set resulterede flyttebevægelserne således i en samlet nettoudflytning fra kommunen."
        }
      ]
    },
    "foedselDoed": {
      "overskrift": "Demografisk analyse for Hvidovre Kommune: 1. kvartal 2026",
      "afsnit": [
        {
          "overskrift": "Seneste kvartal",
          "tekst": "I første kvartal 2026 registrerede Hvidovre Kommune 107 levendefødte og 139 døde, hvilket resulterede i et fødselsunderskud på 32 personer. Dette markerer en faldende tendens sammenlignet med samme kvartal året før, hvor der var 113 fødte og 109 døde og dermed et lille fødselsoverskud. Udviklingen i kvartalet er således præget af et fald i antallet af fødsler sideløbende med en stigning i antallet af dødsfald."
        },
        {
          "overskrift": "Sammenligning med hele landet",
          "tekst": "Indekstallene viser, at fødselstallet i Hvidovre med et indeks på 86,3 ligger markant under landsplanets indeks på 101,1 sammenlignet med basisperioden i 2015. Stigningen i antallet af døde er derimod mindre udtalt i Hvidovre (indeks 119,8) end i hele landet (indeks 127,2). Samlet set betyder det, at Hvidovres befolkningsudvikling er mere udfordret af et lavt fødselsniveau end landet som helhed, på trods af en relativt moderat stigning i dødeligheden."
        }
      ]
    }
  }
}