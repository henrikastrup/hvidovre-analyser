  "analyse": {
    "maanedlig": {
      "overskrift": "Demografisk status for Hvidovre Kommune pr. 1. september 2026",
      "afsnit": [
        {
          "overskrift": "Folketal og udvikling",
          "tekst": "Pr. 1. september 2026 udgjorde folketallet i Hvidovre Kommune 54.236 borgere, hvilket svarer til en beskeden tilbagegang på 5 personer i løbet af august. Set over de seneste 12 måneder udviser kommunen fortsat en positiv befolkningsudvikling med en samlet vækst på 170 indbyggere. Den langsigtede tendens er således fortsat svagt opadgående trods den seneste måneds mindre fald."
        },
        {
          "overskrift": "Indvandring",
          "tekst": "I august 2026 blev der registreret 83 indvandringer til kommunen, hvilket er en stigning fra 52 personer i den foregående måned. Gruppen bestod af 43 mænd og 40 kvinder, hvor 55 % kom fra vestlige lande, og de største enkeltstående oprindelseslande var Kina (13), Indien (6), Italien (5), Spanien (5) og Tyskland (5). Hovedparten af tilflytterne var unge voksne, idet 61 ud af de 83 personer var i aldersgruppen 17-26 år."
        },
        {
          "overskrift": "Alderssammensætning",
          "tekst": "I den samlede befolkning ses den største relative vækst over det seneste år blandt de ældste borgere på 80 år og derover, hvis andel steg fra 5,16 % til 5,35 % svarende til 2.900 personer. Omvendt oplevede de yngste børn i alderen 0-5 år det største fald i befolkningsandel, idet gruppen faldt fra 6,55 % til 6,40 % med et aktuelt antal på 3.472 børn. Forskydningerne peger dermed på en fortsat aldring af kommunens samlede aldersprofil."
        }
      ]
    },
    "kvartal": {
      "overskrift": "Befolkningsudviklingen i Hvidovre Kommune i 2. kvartal 2026",
      "afsnit": [
        {
          "overskrift": "Samlet tilvækst",
          "tekst": "I 2. kvartal 2026 voksede befolkningen i Hvidovre Kommune med 82 personer, hvorved det samlede indbyggertal nåede 54.234 ved kvartalets udgang. Den væsentligste drivkraft bag fremgangen var en markant indenlandsk nettotilflytning. Datamæssige korrektioner nedjusterede tilvæksten med 12 personer."
        },
        {
          "overskrift": "Fødsler og dødsfald",
          "tekst": "Der blev i perioden registreret 129 levendefødte og 125 dødsfald, hvilket resulterede i et beskedent fødselsoverskud på 4 personer. Den naturlige befolkningstilvækst ligger dermed tæt på balance i dette kvartal. Det lave fødselsoverskud betyder, at den naturlige tilvækst kun yder et marginalt bidrag til kommunens samlede vækst."
        },
        {
          "overskrift": "Flytninger og indvandring",
          "tekst": "Nettoresultatet for den indenlandske flytteaktivitet udgjorde en tilvækst på 87 personer som følge af 992 tilflyttere og 905 fraflyttere. Samtidig var den internationale vandring stort set i balance med 99 indvandrede og 96 udvandrede, svarende til en nettoindvandring på 3 personer. Samlet set var det den indenlandske flyttebalance, der tegnede sig for langt størstedelen af kvartalets befolkningsfremgang."
        }
      ]
    },
    "foedselDoed": {
      "overskrift": "Demografisk udvikling i Hvidovre Kommune – 2. kvartal 2026",
      "afsnit": [
        {
          "overskrift": "Seneste kvartal",
          "tekst": "I 2. kvartal 2026 blev der registreret 129 levendefødte og 125 døde i Hvidovre Kommune, hvilket resulterede i et beskedent fødselsoverskud på 4 personer. Mens antallet af fødsler lå tæt på niveauet fra samme kvartal året før (124), steg antallet af dødsfald markant fra 93 til 125. Denne stigning i dødeligheden har reduceret det naturlige befolkningsoverskud væsentligt i forhold til samme periode i 2025."
        },
        {
          "overskrift": "Sammenligning med hele landet",
          "tekst": "Målt i forhold til basisåret 2015 ligger Hvidovres fødselsindeks på 75, hvilket er væsentligt lavere end landsgennemsnittet på 96 og vidner om en mere udtalt lokal nedgang i fødselstallet. Omvendt er indekset for døde på 102,5 under landstallet på 115,7, hvilket afspejler en mere afdæmpet langsigtet stigning i dødeligheden end i resten af landet. Samlet set peger udviklingen på, at Hvidovres naturlige befolkningstilvækst i højere grad er udfordret af faldende fødselstal end af en øget dødelighed set i et nationalt perspektiv."
        }
      ]
    }
  }
}